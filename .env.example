DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/isp_db
DEFAULT_ORGANIZATION_SLUG=smart-fiber
COA_SECRET_PATH=/etc/radiusfiber/coa.secret
RADIUS_RADCLIENT_BIN=/usr/bin/radclient
RADIUS_COA_NAS_IP=192.168.222.1
RADIUS_COA_PORT=3799
PILOT_CALLEDSTATIONID=core-radius-pilot
SMTP_URL=
JWT_SECRET=
PLATFORM_ADMIN_API_KEY=
UPLOAD_PATH=/var/lib/radiusfiber/uploads
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
REDIS_ENABLED=false
WORKERS_ENABLED=false
RATE_LIMIT_ENABLED=false
REDIS_KEY_PREFIX=radiusfiber:staging:
WEBHOOK_MAX_PAYLOAD_BYTES=262144
WEBHOOK_MAX_PROCESSING_ATTEMPTS=5
